# Copy this file to ".env" to change settings. start.bat does this for you.
# The app also works without a .env file (it then uses these default values).

# Port number for the local web page: http://127.0.0.1:8000
JOBSPOT_PORT=8000

# Where saved jobs are stored (a file on this computer only)
JOBSPOT_DB_PATH=data/jobspot.db

# Key for the Bundesagentur job search service.
# This is the public key from the official Jobsuche app, not a personal secret.
JOBSUCHE_API_KEY=jobboerse-jobsuche
